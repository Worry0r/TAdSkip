{
  "manifest_version": 3,
  "name": "RADOVANE MILUJI TĚ",
  "version": "1.4",
  "description": "Radovan je nejlepší",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_icon": {
      "128": "icon.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icon.png"],
      "matches": [
        "*://*.travian.cz/*",
        "*://*.travian.com/*",
        "*://*.traviangames.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.travian.cz/*",
        "*://*.travian.com/*",
        "*://*.traviangames.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}